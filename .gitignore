# Environment variables -- contains real API keys, must never be committed
.env

# Python virtual environment -- huge, machine-specific, never belongs in git
venv/

# Python cache files
__pycache__/
*.pyc

# Local vector store -- generated by ingest.py, not source code
data/vector_store/

# Streamlit
.streamlit/secrets.toml

# OS-specific junk files
.DS_Store
Thumbs.db

# Editor folders
.vscode/

#Log file
run_log.txt